[Unit]
Description=Huawei Smart Assistant Frontend (Vite)
After=network.target huawei-assistant-backend.service

[Service]
Type=simple
User=root
WorkingDirectory=/Huawei-Cloud-Smart-Assistant/frontend
ExecStart=/usr/bin/npx vite --host 0.0.0.0 --port 5173
Restart=always
RestartSec=5
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.nvm/versions/node/v20.19.0/bin

[Install]
WantedBy=multi-user.target
