[Unit]
Description=Huawei Smart Assistant Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/Huawei-Cloud-Smart-Assistant
ExecStart=/Huawei-Cloud-Smart-Assistant/backend/.venv/bin/python -m uvicorn app:app --app-dir backend --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PATH=/Huawei-Cloud-Smart-Assistant/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
